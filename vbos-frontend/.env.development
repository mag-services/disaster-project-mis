# Local development – loaded when running `pnpm dev`
# Uses Vite proxy: API requests go through dev server → backend (no CORS).
# Override in .env.development.local if proxy causes issues (use full URLs).

# Docker Compose maps Django to host port 8080 (see vbos-backend/docker-compose.yml).
# Set in .env.development.local if you use `pnpm dev` against Docker:
#   VITE_PROXY_PORT=8080
# Empty = use same origin (Vite proxies /api and /api-token-auth to backend)
VITE_API_HOST=
VITE_TITILER_API=http://localhost:8043
