# VM / self-hosted deployment – copy to .env.production.local before `pnpm build`
# Use this when serving the app via nginx on your LAN (e.g. http://192.168.1.81/)
#
# Empty VITE_API_HOST = API requests use same origin (relative URLs).
# This makes login and all API calls work when accessed from any device on your network.

VITE_API_HOST=
VITE_TITILER_API=/titiler
