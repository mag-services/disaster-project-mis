# VBoS Frontend – Environment Template
# For local dev: .env.development is used automatically when running `pnpm dev`.
# Override with .env.development.local (ignored by VCS) if needed.
# For production build: .env.production is used.

# ─── Required ─────────────────────────────────────────────────────────────
# Backend API base URL (no trailing slash). Used for auth and dataset endpoints.
VITE_API_HOST=http://localhost:8000

# TiTiler base URL for COG/GeoTIFF raster tile requests.
VITE_TITILER_API=http://localhost:8043

# When running both vbos-backend and VM deploy: vbos-backend uses 8080 and 8043 (Titiler).
# Set in .env.development.local: VITE_PROXY_PORT=8080 VITE_API_HOST=http://localhost:8080 VITE_TITILER_API=http://localhost:8043

# ─── Optional ─────────────────────────────────────────────────────────────
# Optional: set a roadmap URL for “on the roadmap” nav toasts.
# If unset, the roadmap link is hidden.
# VITE_ROADMAP_URL=https://example.com/drmis/TASKS.md

# Override terrain DEM tiles URL for 3D map (default: MapLibre demotiles).
# VITE_TERRAIN_TILES_URL=https://demotiles.maplibre.org/terrain-tiles/tiles.json

# ─── Production ───────────────────────────────────────────────────────────
# Replace with your deployed backend and TiTiler URLs, e.g.:
# VITE_API_HOST=https://api.example.com
# VITE_TITILER_API=https://tiles.example.com
