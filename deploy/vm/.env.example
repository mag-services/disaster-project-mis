# VM deployment – copy to .env in project root or deploy/vm/
# Used by: docker compose -f deploy/vm/docker-compose.yml up

DJANGO_SECRET_KEY=your-long-random-secret-key

# Required: URL used to access the app (no trailing slash)
# LAN: http://192.168.1.81  |  Production (HTTPS): https://mis.ndmo.gov.vu
# HTTPS enables geolocation, screen capture, PWA; Django auto-enables secure cookies
DJANGO_VM_HOST=http://192.168.1.81

# Optional: timezone for logs (default: Pacific/Fiji)
# TZ=Pacific/Fiji
